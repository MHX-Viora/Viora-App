{
  "expo": {
    "name": "ANKT",
    "slug": "viora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/viora_logo.png",
    "scheme": "viora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "associatedDomains": [
        "applinks:viora.app"
      ],
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/viora_logo.png",
        "backgroundImage": "./assets/images/viora_logo.png",
        "monochromeImage": "./assets/images/viora_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.quyentrinh.viora",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "viora.app",
              "pathPrefix": "/post"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "com-quyentrinh-viora.firebaseapp.com",
              "pathPrefix": "/__/auth/links"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-notifee-call-config",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ankt_launch.jpg",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/ankt_launch.jpg",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Mạng xã hội ANKT dùng vị trí để hiển thị thời tiết nơi bạn đang ở."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Mạng xã hội ANKT dùng camera để quay video và quét mã QR hồ sơ.",
          "microphonePermission": "Cho phép Mạng xã hội ANKT dùng micro để ghi âm khi quay video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Mạng xã hội ANKT truy cập ảnh để bạn chia sẻ trong bài viết.",
          "microphonePermission": "Cho phép Mạng xã hội ANKT dùng micro để ghi âm tin nhắn."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/viora_logo.png",
          "color": "#2868D7",
          "sounds": [
            "./assets/audio/nhac_chuong.mp3"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "@livekit/react-native-expo-plugin",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebaseProjectId": "com-quyentrinh-viora"
    }
  }
}
