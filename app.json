{
  "expo": {
    "name": "viora",
    "slug": "viora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/viora_logo.png",
    "scheme": "viora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "associatedDomains": [
        "applinks:viora.app"
      ],
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/viora_logo.png",
        "backgroundImage": "./assets/images/viora_logo.png",
        "monochromeImage": "./assets/images/viora_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.quyentrinh.viora",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "viora.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/viora_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Viora dùng vị trí để hiển thị thời tiết nơi bạn đang ở."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Viora dùng camera để quét mã QR hồ sơ."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Viora truy cập ảnh để bạn chia sẻ trong bài viết.",
          "microphonePermission": "Cho phép Viora dùng micro để ghi âm tin nhắn."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2868D7"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebaseProjectId": "com-quyentrinh-viora"
    }
  }
}
