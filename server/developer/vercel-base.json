{
  "headers": [
    {"source":"/sdk/ankt-miniapp.v:version.min.js","headers":[{"key":"Content-Type","value":"application/javascript; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=31536000, immutable"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/sdk/ankt-miniapp.js","headers":[{"key":"Content-Type","value":"application/javascript; charset=utf-8"},{"key":"Cache-Control","value":"no-cache"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/sdk/manifest.json","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {
      "source": "/developers/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' https: blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/developers/api/account/:path*",
      "destination": "/api/developer?path=:path*"
    },
    {
      "source": "/developers/api/health",
      "destination": "/api/developer?kind=health"
    },
    {
      "source": "/((?!sdk/|assets|_expo|favicon.ico|robots.txt|developer-sitemap.xml|developers/brand.png|manifest.webmanifest|firebase-messaging-sw.js|pwa-icon-192.png|pwa-icon-512.png).*)",
      "destination": "/"
    }
  ]
}
