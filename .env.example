EXPO_PUBLIC_API_URL=https://api.example.com
# Developer is part of this FE. Server-only settings below must never use EXPO_PUBLIC_.
# Local Metro uses the current loopback origin and EXPO_PUBLIC_API_URL automatically.
# Production: configure the same values in the FE host's server environment.
DEVELOPER_SITE_ORIGIN=
ANKT_API_BASE_URL=
# Production: DEVELOPER_SITE_ORIGIN=https://mxh.ankt.vn; ANKT_API_BASE_URL=<actual BE origin>.
# At least 32 characters, matching BE DeveloperAuth__BffSharedSecret; keep blank in source.
ANKT_BFF_SHARED_SECRET=
EXPO_PUBLIC_OPEN_API_ISSUER=https://openapi.example.com

# Firebase Web app configuration from Firebase Console > Project settings > Your apps.
# These are public Firebase identifiers; never place a service-account private key here.
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_WEB_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
EXPO_PUBLIC_FIREBASE_WEB_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_WEB_VAPID_KEY=

# Existing native Google Sign-In OAuth Web client ID. Keep this for Android/iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_FIREBASE_EMAIL_LINK_URL=
EXPO_PUBLIC_FIREBASE_EMAIL_LINK_DOMAIN=
