EXPO_PUBLIC_API_URL=https://api.example.com
# New default integration path: enable after deploying the Auth Bridge API/schema.
EXPO_PUBLIC_MINI_APP_AUTH_BRIDGE_ENABLED=false
# Native debug/release builds also require EXPO_PUBLIC_MINI_APP_NATIVE_RUNTIME_ENABLED=true.
EXPO_PUBLIC_MINI_APP_NATIVE_RUNTIME_ENABLED=false
# Mini App secrets are retrieved through the authenticated Developer API, never EXPO_PUBLIC_.
# Developer is part of this FE. Server-only settings below must never use EXPO_PUBLIC_.
# Local Metro uses the current loopback origin and EXPO_PUBLIC_API_URL automatically.
# Local Sandbox: Mini App uses SDK >=0.3.1 with hostOrigin='http://localhost:8081'.
# Backend stays HTTPS; keep Render MiniAppAuth__AllowedHostOrigin=https://mxh.ankt.vn.
# Production: configure the same values in the FE host's server environment.
DEVELOPER_SITE_ORIGIN=
ANKT_API_BASE_URL=
# Production: DEVELOPER_SITE_ORIGIN=https://mxh.ankt.vn; ANKT_API_BASE_URL=<actual BE origin>.
# At least 32 characters, matching BE DeveloperAuth__BffSharedSecret; keep blank in source.
ANKT_BFF_SHARED_SECRET=
EXPO_PUBLIC_OPEN_API_ISSUER=https://openapi.example.com
# OPEN_API_ISSUER and ANKT_SANDBOX_HOST_ORIGIN below are legacy OIDC/managed-host options.
# They are not required when MINI_APP_AUTH_BRIDGE_ENABLED=true.
# Required on the deployed FE build host for the Sandbox account launch form CSP.
# Use the backend's actual Sso__Issuer. Local Metro needs no separate Sandbox host.
# Optional Vercel build-time Sandbox frame-src; must match BE MiniAppSandbox__HostOrigin.
# Blank keeps all Developer pages at frame-src 'none'. Requires explicit HTTPS
# DEVELOPER_SITE_ORIGIN and EXPO_PUBLIC_OPEN_API_ISSUER on distinct hostnames.
ANKT_SANDBOX_HOST_ORIGIN=
# ANKT deployment: https://sandbox.ankt.vn after its Render DNS/TLS setup.
# Set this on the FE build host, together with DEVELOPER_SITE_ORIGIN and
# EXPO_PUBLIC_OPEN_API_ISSUER. Backend Render variables do not reach FE builds.

# Firebase Web app configuration from Firebase Console > Project settings > Your apps.
# These are public Firebase identifiers; never place a service-account private key here.
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_WEB_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
EXPO_PUBLIC_FIREBASE_WEB_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_WEB_VAPID_KEY=

# Existing native Google Sign-In OAuth Web client ID. Keep this for Android/iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_FIREBASE_EMAIL_LINK_URL=
EXPO_PUBLIC_FIREBASE_EMAIL_LINK_DOMAIN=
